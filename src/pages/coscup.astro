---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={`COSCUP | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <article>
    <div class="prose max-w-none">
      <h1 class="mb-4 text-2xl">COSCUP 簡報 & 相關連結</h1>
      <ul>
        <li>
          <a
            href="https://www.figma.com/deck/OPLcItSUnkTI8sspb9jbFG/%E5%A6%82%E4%BD%95%E5%AE%A3%E5%82%B3%E4%BD%A0%E7%9A%84-Side-Project?node-id=2-553&t=sqGZQ4acKdXCYWgY-1"
            target="_blank"
            rel="noopener noreferrer"
          >
            簡報連結
          </a>
        </li>
        <li>
          <a
            href="https://repohistory.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            Repohistory
          </a>
        </li>
        <li>
          <a
            href="https://github.com/m4xshen"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </li>
        <li>
          <a
            href="https://threads.com/@m4xshen.dev"
            target="_blank"
            rel="noopener noreferrer"
          >
            Threads
          </a>
        </li>
      </ul>
    </div>
  </article>
</BaseLayout>
